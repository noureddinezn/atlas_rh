    {
      "name": "Create department",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/departments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Engineering {{$guid}}\",\n  \"description\": \"Engineering team\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"departmentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
